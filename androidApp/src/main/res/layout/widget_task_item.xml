<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/widget_task_status_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="10dp"
        android:src="@android:drawable/checkbox_off_background"
        android:tint="#3B82F6" />

    <TextView
        android:id="@+id/widget_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Görev Başlığı"
        android:textColor="#F3F4F6"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_task_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="14:00"
        android:textColor="#9CA3AF"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
