-- 1. SQLDelight vs PostgreSQL Farkı:
-- PostgreSQL backend (sunucu) tarafında çalışan ana veritabanıdır.
-- SQLDelight ise uygulamanın içine gömülü (telefonun hafızasındaki) SQLite tabanlı YEREL bir veritabanıdır.
-- Soru: Neden Post'lar için oluşturduk da User (Login/Register) için oluşturmadık?
-- Cevap: Kullanıcı giriş yaptığında dönen User verisi (isim, token vs.) çok ufaktır ve DataStore gibi basit yerlerde saklanabilir.
-- Ancak Ana Sayfadaki "Postlar", binlerce veri içerebilir, bunlar üzerinde sayfalama, filtreleme ve çevrimdışı (internetsiz) okuma (Offline-First) yapmamız gerekir.
-- Bu yüzden Post'lar için telefonda gerçek bir ilişkisel veritabanına ihtiyacımız var.

CREATE TABLE postEntity (
    id TEXT NOT NULL PRIMARY KEY,
    ownerId TEXT NOT NULL,
    authorId TEXT NOT NULL,
    authorName TEXT NOT NULL,
    authorUsername TEXT NOT NULL,
    content TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    likesCount INTEGER NOT NULL,
    commentsCount INTEGER NOT NULL,
    isLikedByMe INTEGER NOT NULL,
    isBookmarkedByMe INTEGER NOT NULL DEFAULT 0,
    topic TEXT NOT NULL
);

CREATE INDEX index_postEntity_ownerId_createdAt ON postEntity(ownerId, createdAt DESC);
CREATE INDEX index_postEntity_ownerId_topic ON postEntity(ownerId, topic);
-- 2. SAYFALAMA BİLGİSİNİ TUTAN TABLO (Remote Key):
-- İnternetsiz çalışırken uygulamanın en son hangi sayfada kaldığını bilmesi gerekir.
-- "nextPage", API'den dönen ve bir sonraki isteği atarken kullanılacak olan sayfalamanın anahtarıdır.
CREATE TABLE remoteKeyEntity (
    id TEXT NOT NULL PRIMARY KEY,
    ownerId TEXT NOT NULL,
    nextPage TEXT
);

insertPost:
INSERT OR REPLACE INTO postEntity(
    id, ownerId, authorId, authorName, authorUsername, content, createdAt, likesCount, commentsCount, isLikedByMe, isBookmarkedByMe, topic
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllPosts:
SELECT * FROM postEntity
WHERE ownerId = :ownerId AND (:topic IS NULL OR :topic = 'Tümü' OR topic = :topic)
ORDER BY createdAt DESC
LIMIT :limit OFFSET :offset;

countAllPosts:
SELECT count(*) FROM postEntity
WHERE ownerId = :ownerId AND (:topic IS NULL OR :topic = 'Tümü' OR topic = :topic);

getBookmarkedPosts:
SELECT * FROM postEntity
WHERE ownerId = :ownerId AND isBookmarkedByMe = 1
ORDER BY createdAt DESC;

deleteAllPosts:
DELETE FROM postEntity WHERE ownerId = :ownerId;

insertRemoteKey:
INSERT OR REPLACE INTO remoteKeyEntity(id, ownerId, nextPage)
VALUES (?, ?, ?);

getRemoteKey:
SELECT * FROM remoteKeyEntity WHERE id = :id AND ownerId = :ownerId;

deleteAllRemoteKeys:
DELETE FROM remoteKeyEntity WHERE ownerId = :ownerId;

-- 3. OFFLINE-FIRST: TASLAK VE KUYRUK SİSTEMİ
-- İnternet yokken oluşturulan postlar veya taslaklar burada tutulur.
CREATE TABLE pendingPostEntity (
    id TEXT NOT NULL PRIMARY KEY,
    ownerId TEXT NOT NULL,
    content TEXT NOT NULL,
    isDraft INTEGER NOT NULL, -- 1=Taslak, 0=Gönderilmeyi Bekliyor (Kuyruk)
    createdAt INTEGER NOT NULL,
    topic TEXT NOT NULL
);

CREATE INDEX index_pendingPostEntity_ownerId_createdAt ON pendingPostEntity(ownerId, createdAt);
insertPendingPost:
INSERT OR REPLACE INTO pendingPostEntity(id, ownerId, content, isDraft, createdAt, topic)
VALUES (?, ?, ?, ?, ?, ?);

getAllPendingPosts:
SELECT * FROM pendingPostEntity
WHERE ownerId = :ownerId
ORDER BY createdAt DESC;

getPendingPostsToSync:
SELECT * FROM pendingPostEntity
WHERE ownerId = :ownerId AND isDraft = 0
ORDER BY createdAt ASC;

deletePendingPost:
DELETE FROM pendingPostEntity
WHERE id = ?;

updatePendingPostToSync:
UPDATE pendingPostEntity
SET isDraft = 0
WHERE id = ?;

deleteAllPendingPosts:
DELETE FROM pendingPostEntity WHERE ownerId = :ownerId;

-- 4. PLAN ROOM & TASK (Görev, Not) SİSTEMİ
CREATE TABLE planRoomEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    creatorId INTEGER NOT NULL,
    createdAt INTEGER NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE planRoomMemberEntity (
    roomId TEXT NOT NULL,
    userId INTEGER NOT NULL,
    status TEXT NOT NULL,
    role TEXT NOT NULL,
    joinedAt INTEGER,
    PRIMARY KEY (roomId, userId)
);

CREATE TABLE taskEntity (
    id TEXT NOT NULL PRIMARY KEY,
    creatorId INTEGER NOT NULL,
    title TEXT NOT NULL,
    description TEXT,
    startTime INTEGER NOT NULL,
    endTime INTEGER,
    type TEXT NOT NULL,
    status TEXT NOT NULL,
    visibility TEXT NOT NULL,
    isRecurring INTEGER NOT NULL DEFAULT 0,
    recurrenceRule TEXT,
    isFlexible INTEGER NOT NULL DEFAULT 0,
    isOptional INTEGER NOT NULL DEFAULT 0,
    isPostponable INTEGER NOT NULL DEFAULT 1,
    isAllDay INTEGER NOT NULL DEFAULT 0,
    aiMetadata TEXT,
    reminders TEXT,
    specificDetails TEXT,
    tags TEXT,
    color TEXT,
    parentId TEXT,
    participants TEXT,
    isPinned INTEGER NOT NULL DEFAULT 0,
    isSynced INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX index_taskEntity_startTime ON taskEntity(startTime ASC);
CREATE INDEX index_taskEntity_isSynced ON taskEntity(isSynced);
CREATE TABLE taskSharedRoomEntity (
    taskId TEXT NOT NULL,
    roomId TEXT NOT NULL,
    PRIMARY KEY (taskId, roomId)
);

-- PlanRoom Sorguları
insertPlanRoom:
INSERT OR REPLACE INTO planRoomEntity(id, name, creatorId, createdAt, isSynced)
VALUES (?, ?, ?, ?, ?);

getAllPlanRooms:
SELECT * FROM planRoomEntity;

deleteAllPlanRooms:
DELETE FROM planRoomEntity;

updatePlanRoomName:
UPDATE planRoomEntity SET name = :name WHERE id = :id;

deletePlanRoom:
DELETE FROM planRoomEntity WHERE id = :id;

-- PlanRoomMember Sorguları
insertPlanRoomMember:
INSERT OR REPLACE INTO planRoomMemberEntity(roomId, userId, status, role, joinedAt)
VALUES (?, ?, ?, ?, ?);

getMembersForRoom:
SELECT * FROM planRoomMemberEntity WHERE roomId = :roomId;

clearAllPosts:
DELETE FROM postEntity;

clearAllRemoteKeys:
DELETE FROM remoteKeyEntity;

clearAllPendingPosts:
DELETE FROM pendingPostEntity;

deleteAllPlanRoomMembers:
DELETE FROM planRoomMemberEntity;

deleteMembersForRoom:
DELETE FROM planRoomMemberEntity WHERE roomId = :roomId;

deleteTaskSharedRoomsForRoom:
DELETE FROM taskSharedRoomEntity WHERE roomId = :roomId;

-- Task Sorguları
insertTask:
INSERT OR REPLACE INTO taskEntity(
    id, creatorId, title, description, startTime, endTime, type, status, visibility, isRecurring, recurrenceRule, isFlexible, isOptional, isPostponable, isAllDay, aiMetadata, reminders, specificDetails, tags, color, parentId, participants, isPinned, isSynced
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllTasks:
SELECT * FROM taskEntity ORDER BY startTime ASC;

getTasksByTimeRange:
SELECT * FROM taskEntity 
WHERE startTime >= :fromTime AND startTime <= :toTime 
ORDER BY startTime ASC;

deleteTaskById:
DELETE FROM taskEntity WHERE id = :id;

deleteAllTasks:
DELETE FROM taskEntity;

getTaskById:
SELECT * FROM taskEntity WHERE id = :id;

updateTaskStatus:
UPDATE taskEntity SET status = :status, isSynced = :isSynced WHERE id = :id;

-- TaskSharedRoom Sorguları
insertTaskSharedRoom:
INSERT OR REPLACE INTO taskSharedRoomEntity(taskId, roomId)
VALUES (?, ?);

getSharedRoomsForTask:
SELECT roomId FROM taskSharedRoomEntity WHERE taskId = :taskId;

getTaskIdsForRoom:
SELECT taskId FROM taskSharedRoomEntity WHERE roomId = :roomId;

deleteTaskSharedRoomsForTask:
DELETE FROM taskSharedRoomEntity WHERE taskId = :taskId;

deleteAllTaskSharedRooms:
DELETE FROM taskSharedRoomEntity;

deleteTasksById:
DELETE FROM taskEntity WHERE id IN ?;

-- 5. TASK EXCEPTIONS (For On-The-Fly Recurring Tasks)
CREATE TABLE taskExceptionEntity (
    taskId TEXT NOT NULL,
    dateMs INTEGER NOT NULL,
    isCompleted INTEGER NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (taskId, dateMs)
);

insertTaskException:
INSERT OR REPLACE INTO taskExceptionEntity(taskId, dateMs, isCompleted, isSynced)
VALUES (?, ?, ?, ?);

getExceptionsForTask:
SELECT * FROM taskExceptionEntity WHERE taskId = :taskId;

getAllTaskExceptions:
SELECT * FROM taskExceptionEntity;

deleteAllTaskExceptions:
DELETE FROM taskExceptionEntity;

deleteExceptionsForTask:
DELETE FROM taskExceptionEntity WHERE taskId = :taskId;

getUnsyncedTasks:
SELECT * FROM taskEntity WHERE isSynced = 0;

updateTaskSyncStatus:
UPDATE taskEntity SET isSynced = :isSynced WHERE id = :id;

updateChildTaskParentIds:
UPDATE taskEntity SET parentId = :newParentId WHERE parentId = :oldParentId;

-- 6. CALENDAR ACCESS
CREATE TABLE calendarAccessEntity (
    userId INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    username TEXT NOT NULL,
    avatarId TEXT NOT NULL,
    color TEXT NOT NULL,
    profileImageUrl TEXT
);

insertCalendarAccess:
INSERT OR REPLACE INTO calendarAccessEntity(userId, name, username, avatarId, color, profileImageUrl)
VALUES (?, ?, ?, ?, ?, ?);

getAllCalendarAccess:
SELECT * FROM calendarAccessEntity;

deleteAllCalendarAccess:
DELETE FROM calendarAccessEntity;

deleteCalendarAccessByUserId:
DELETE FROM calendarAccessEntity WHERE userId = :userId;
