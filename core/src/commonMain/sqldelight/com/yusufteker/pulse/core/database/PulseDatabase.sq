-- 1. SQLDelight vs PostgreSQL Farkı:
-- PostgreSQL backend (sunucu) tarafında çalışan ana veritabanıdır.
-- SQLDelight ise uygulamanın içine gömülü (telefonun hafızasındaki) SQLite tabanlı YEREL bir veritabanıdır.
-- Soru: Neden Post'lar için oluşturduk da User (Login/Register) için oluşturmadık?
-- Cevap: Kullanıcı giriş yaptığında dönen User verisi (isim, token vs.) çok ufaktır ve DataStore gibi basit yerlerde saklanabilir.
-- Ancak Ana Sayfadaki "Postlar", binlerce veri içerebilir, bunlar üzerinde sayfalama, filtreleme ve çevrimdışı (internetsiz) okuma (Offline-First) yapmamız gerekir.
-- Bu yüzden Post'lar için telefonda gerçek bir ilişkisel veritabanına ihtiyacımız var.

CREATE TABLE postEntity (
    id TEXT NOT NULL PRIMARY KEY,
    authorId TEXT NOT NULL,
    authorName TEXT NOT NULL,
    authorUsername TEXT NOT NULL,
    content TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    likesCount INTEGER NOT NULL,
    commentsCount INTEGER NOT NULL,
    isLikedByMe INTEGER NOT NULL,
    topic TEXT NOT NULL
);

-- 2. SAYFALAMA BİLGİSİNİ TUTAN TABLO (Remote Key):
-- İnternetsiz çalışırken uygulamanın en son hangi sayfada kaldığını bilmesi gerekir.
-- "nextPage", API'den dönen ve bir sonraki isteği atarken kullanılacak olan sayfalamanın anahtarıdır.
CREATE TABLE remoteKeyEntity (
    id TEXT NOT NULL PRIMARY KEY,
    nextPage TEXT
);

insertPost:
INSERT OR REPLACE INTO postEntity(
    id, authorId, authorName, authorUsername, content, createdAt, likesCount, commentsCount, isLikedByMe, topic
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllPosts:
SELECT * FROM postEntity
WHERE :topic IS NULL OR :topic = 'Tümü' OR topic = :topic
ORDER BY createdAt DESC
LIMIT :limit OFFSET :offset;

countAllPosts:
SELECT count(*) FROM postEntity
WHERE :topic IS NULL OR :topic = 'Tümü' OR topic = :topic;

deleteAllPosts:
DELETE FROM postEntity;

insertRemoteKey:
INSERT OR REPLACE INTO remoteKeyEntity(id, nextPage)
VALUES (?, ?);

getRemoteKey:
SELECT * FROM remoteKeyEntity WHERE id = ?;

deleteAllRemoteKeys:
DELETE FROM remoteKeyEntity;

-- 3. OFFLINE-FIRST: TASLAK VE KUYRUK SİSTEMİ
-- İnternet yokken oluşturulan postlar veya taslaklar burada tutulur.
CREATE TABLE pendingPostEntity (
    id TEXT NOT NULL PRIMARY KEY,
    content TEXT NOT NULL,
    isDraft INTEGER NOT NULL, -- 1=Taslak, 0=Gönderilmeyi Bekliyor (Kuyruk)
    createdAt INTEGER NOT NULL,
    topic TEXT NOT NULL
);

insertPendingPost:
INSERT OR REPLACE INTO pendingPostEntity(id, content, isDraft, createdAt, topic)
VALUES (?, ?, ?, ?, ?);

getAllPendingPosts:
SELECT * FROM pendingPostEntity
ORDER BY createdAt DESC;

getPendingPostsToSync:
SELECT * FROM pendingPostEntity
WHERE isDraft = 0
ORDER BY createdAt ASC;

deletePendingPost:
DELETE FROM pendingPostEntity
WHERE id = ?;

updatePendingPostToSync:
UPDATE pendingPostEntity
SET isDraft = 0
WHERE id = ?;
