# PostgreSQL Database Connection
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=<password>

# JWT Authentication (Generate a secure 256-bit random key via `openssl rand -hex 32`)
JWT_SECRET=<your_secure_random_jwt_secret>
JWT_ISSUER=http://0.0.0.0:8080/

# Admin Secret Key for API protection (Generate a secure random key via `openssl rand -hex 32`)
ADMIN_SECRET_KEY=<your_secure_random_admin_secret>

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# Email / Notification Services
GMAIL_SCRIPT_URL=<gmail_script_url>
GEMINI_API_KEY=<gemini_api_key>
